
/*
====================================================================
BLACKBOARD DATA ILLUMINATE
FALL 2026 - ALL STUDENT COURSE ACTIVITY
====================================================================

INCLUDES:
  - Available, enabled regular students (S)
  - Enabled Student Orientation Pending students (SOP)
  - Students with 0, 1, 2, or more course accesses

EXCLUDES:
  - Disabled or deleted enrollments
  - Unrelated observer roles (COO, OO)
  - PreviewUser accounts
  - Deleted courses and child courses

REPORTS:
  - Student information
  - Course information
  - Course access count
  - Activity status
  - Last course access
  - Course activity hours
  - Enrollment category
  - NCO5102 Final Assessment score
  - Course Acceptance Acknowledgement score

IMPORTANT:
  STUDENT_LOGIN_COUNT counts COURSE_ACTIVITY records,
  which are course accesses, not necessarily separate
  Blackboard authentication logins.

  Enrollment flags do not definitively identify withdrawals.
====================================================================
*/

WITH courses AS (
    SELECT
        c.id AS Course_ID,
        c.course_number AS Learn_Course_ID,
        c.name AS Course_Name,
        c.start_date AS Course_Start

    FROM CDM_LMS.COURSE c

    WHERE c.row_deleted_time IS NULL
      AND c.course_parent_id IS NULL
      AND c.start_date IS NOT NULL
      AND c.available_ind = TRUE
      AND c.available_to_students_ind = TRUE
      AND c.course_number LIKE '%_2026_FA'

      -- Courses started within the last 12 days
      AND DATEDIFF(
          DAY,
          TO_DATE(c.start_date),
          CURRENT_DATE()
      ) BETWEEN 0 AND 12
),

/*
====================================================================
ELIGIBLE STUDENT ENROLLMENTS
====================================================================
*/
enrollment AS (
    SELECT
        pc.id AS Person_Course_ID,
        pc.course_id,
        pc.person_id,

        TRIM(p.stage:student_id::STRING) AS Student_ID,
        p.last_name AS Student_Last_Name,
        p.first_name AS Student_First_Name,
        p.email AS Student_Email,

        c.Course_Start,
        c.Learn_Course_ID,
        c.Course_Name,

        pc.course_role AS Enrollment_Role,
        pc.course_role_source_code AS Enrollment_Role_Source_Code,
        pc.available_ind AS Enrollment_Available,
        pc.enabled_ind AS Enrollment_Enabled,

        CASE
            WHEN pc.course_role_source_code = 'SOP'
                THEN 'STUDENT ORIENTATION PENDING'

            WHEN pc.course_role_source_code = 'S'
                THEN 'AVAILABLE STUDENT'

            ELSE 'OTHER'
        END AS Enrollment_Category

    FROM CDM_LMS.PERSON_COURSE pc

    JOIN courses c
        ON c.Course_ID = pc.course_id

    JOIN CDM_LMS.PERSON p
        ON p.id = pc.person_id

    WHERE pc.row_deleted_time IS NULL
      AND p.row_deleted_time IS NULL

      -- Exclude disabled enrollments
      AND pc.enabled_ind = TRUE

      -- Include regular and orientation-pending students
      AND (
          (
              pc.course_role_source_code = 'S'
              AND pc.available_ind = TRUE
          )
          OR pc.course_role_source_code = 'SOP'
      )

      -- Exclude Blackboard PreviewUser accounts
      AND COALESCE(
          p.stage:user_id::STRING,
          ''
      ) NOT ILIKE '%PreviewUser%'

      -- Require valid student ID
      AND NULLIF(
          TRIM(p.stage:student_id::STRING),
          ''
      ) IS NOT NULL
),

/*
====================================================================
STUDENT COURSE ACTIVITY
====================================================================
*/
student_activity AS (
    SELECT
        e.Person_Course_ID,
        e.course_id,

        e.Student_ID,
        e.Student_Last_Name,
        e.Student_First_Name,
        e.Student_Email,

        e.Course_Start,
        e.Learn_Course_ID,
        e.Course_Name,

        e.Enrollment_Role,
        e.Enrollment_Role_Source_Code,
        e.Enrollment_Available,
        e.Enrollment_Enabled,
        e.Enrollment_Category,

        -- Count course accesses
        COUNT(ca.id) AS Student_Login_Count,

        -- Most recent course access
        DATE_TRUNC(
            'minute',
            MAX(ca.last_accessed_time)
        ) AS Student_Last_Access,

        -- Total course activity hours
        COALESCE(
            ROUND(
                SUM(ca.duration_sum) / 3600,
                2
            ),
            0
        ) AS Student_Course_Activity_Hours

    FROM enrollment e

    LEFT JOIN CDM_LMS.COURSE_ACTIVITY ca
        ON ca.person_course_id = e.Person_Course_ID
       AND ca.row_deleted_time IS NULL

    GROUP BY
        e.Person_Course_ID,
        e.course_id,
        e.Student_ID,
        e.Student_Last_Name,
        e.Student_First_Name,
        e.Student_Email,
        e.Course_Start,
        e.Learn_Course_ID,
        e.Course_Name,
        e.Enrollment_Role,
        e.Enrollment_Role_Source_Code,
        e.Enrollment_Available,
        e.Enrollment_Enabled,
        e.Enrollment_Category
),

/*
====================================================================
NCO5102 FINAL ASSESSMENT SCORES
====================================================================
*/
final_scores AS (
    SELECT
        TRIM(p.stage:student_id::STRING) AS Student_ID,

        MAX(g.score) AS Final_Assessment_Score

    FROM CDM_LMS.COURSE c

    JOIN CDM_LMS.GRADEBOOK gb
        ON gb.course_id = c.id

    JOIN CDM_LMS.PERSON_COURSE pc
        ON pc.course_id = c.id

    JOIN CDM_LMS.PERSON p
        ON p.id = pc.person_id

    LEFT JOIN CDM_LMS.GRADE g
        ON g.gradebook_id = gb.id
       AND g.person_course_id = pc.id
       AND g.row_deleted_time IS NULL

    WHERE c.course_number LIKE '%NCO5102%'
      AND c.course_parent_id IS NULL
      AND c.row_deleted_time IS NULL

      AND gb.row_deleted_time IS NULL
      AND gb.deleted_ind = FALSE
      AND TRIM(gb.name) ILIKE 'Final Assessment'

      AND pc.course_role = 'S'
      AND pc.enabled_ind = TRUE
      AND pc.row_deleted_time IS NULL

      AND p.row_deleted_time IS NULL
      AND COALESCE(
          p.stage:user_id::STRING,
          ''
      ) NOT ILIKE '%PreviewUser%'

    GROUP BY
        TRIM(p.stage:student_id::STRING)
),

/*
====================================================================
COURSE ACCEPTANCE ACKNOWLEDGEMENT SCORES
====================================================================
*/
acceptance_scores AS (
    SELECT
        e.Person_Course_ID,
        e.course_id,

        MAX(g.score)
            AS Course_Acceptance_Acknowledgement_Score

    FROM enrollment e

    JOIN CDM_LMS.GRADEBOOK gb
        ON gb.course_id = e.course_id
       AND gb.row_deleted_time IS NULL
       AND gb.deleted_ind = FALSE
       AND TRIM(gb.name) ILIKE
           'Course Acceptance Acknowledgement'

    LEFT JOIN CDM_LMS.GRADE g
        ON g.gradebook_id = gb.id
       AND g.person_course_id = e.Person_Course_ID
       AND g.row_deleted_time IS NULL

    GROUP BY
        e.Person_Course_ID,
        e.course_id
)

/*
====================================================================
FINAL RESULTS - ALL ELIGIBLE STUDENTS
====================================================================
*/
SELECT
    sa.Student_ID,
    sa.Student_Last_Name,
    sa.Student_First_Name,
    sa.Student_Email,

    sa.Course_Start,
    sa.Learn_Course_ID,
    sa.Course_Name,

    -- Number of course accesses
    sa.Student_Login_Count,

    -- Activity classification
    CASE
        WHEN sa.Student_Login_Count = 0
            THEN 'NO COURSE ACCESS'

        WHEN sa.Student_Login_Count = 1
            THEN '1 COURSE ACCESS'

        ELSE 'MULTIPLE COURSE ACCESSES'
    END AS Student_Activity_Status,

    sa.Student_Last_Access,
    sa.Student_Course_Activity_Hours,

    -- Enrollment information
    sa.Enrollment_Category,
    sa.Enrollment_Role_Source_Code,
    sa.Enrollment_Role,
    sa.Enrollment_Available,
    sa.Enrollment_Enabled,

    -- NCO5102 Final Assessment
    fs.Final_Assessment_Score,

    -- Course Acceptance Acknowledgement
    ac.Course_Acceptance_Acknowledgement_Score

FROM student_activity sa

LEFT JOIN final_scores fs
    ON fs.Student_ID = sa.Student_ID

LEFT JOIN acceptance_scores ac
    ON ac.Person_Course_ID = sa.Person_Course_ID
   AND ac.course_id = sa.course_id

-- No activity-count restriction:
-- Includes students with 0, 1, 2, or more accesses

ORDER BY
    sa.Student_Login_Count ASC,
    sa.Enrollment_Category,
    sa.Student_Last_Name,
    sa.Student_First_Name,
    sa.Student_ID,
    sa.Learn_Course_ID;
